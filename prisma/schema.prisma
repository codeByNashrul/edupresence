generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  nama          String
  nip           String   @unique
  password      String
  noWa          String?
  role          Role
  rolesTambahan Role[]   @default([])
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  absensi            Absensi[]       @relation("AbsensiPegawai")
  absensiYangDicatat Absensi[]       @relation("AbsensiDicatatOleh")
  catatanHarian      CatatanHarian[]
  guru               Guru?
  izin               Izin[]
  kegiatanStaff      KegiatanStaff[]
  pengumuman         Pengumuman[]

  tukarJadwalDiajukan TukarJadwal[] @relation("UserTukarPengaju")
  tukarJadwalDiterima TukarJadwal[] @relation("UserTukarPenerima")

  @@map("users")
}

model UserOrtu {
  id        String   @id @default(cuid())
  nama      String
  nis       String   @unique
  password  String
  siswaId   String   @unique
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siswa     Siswa    @relation(fields: [siswaId], references: [id])

  @@map("user_ortu")
}

model Guru {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jadwal    Jadwal[]

  @@map("guru")
}

model Kelas {
  id           String         @id @default(cuid())
  nama         String         @unique
  tingkat      String
  aktif        Boolean        @default(true)
  createdAt    DateTime       @default(now())
  absensiSiswa AbsensiSiswa[]
  jadwal       Jadwal[]
  siswa        Siswa[]

  @@map("kelas")
}

model MataPelajaran {
  id        String   @id @default(cuid())
  nama      String   @unique
  kode      String   @unique
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  jadwal    Jadwal[]

  @@map("mata_pelajaran")
}

model Ruangan {
  id        String    @id @default(cuid())
  nama      String    @unique
  kodeQr    String    @unique
  aktif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  absensi   Absensi[]
  jadwal    Jadwal[]

  @@map("ruangan")
}

model Jadwal {
  id              String           @id @default(cuid())
  guruId          String
  kelasId         String
  mataPelajaranId String
  ruanganId       String
  hari            HariMinggu
  jamMulai        String
  jamSelesai      String
  aktif           Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  semester        SemesterAkademik @default(GANJIL)
  tahunAjaran     String           @default("2026/2027")
  absensi         Absensi[]
  guru            Guru             @relation(fields: [guruId], references: [id])
  kelas           Kelas            @relation(fields: [kelasId], references: [id])
  mataPelajaran   MataPelajaran    @relation(fields: [mataPelajaranId], references: [id])
  ruangan         Ruangan          @relation(fields: [ruanganId], references: [id])

  tukarSebagaiPengaju  TukarJadwal[] @relation("JadwalTukarPengaju")
  tukarSebagaiPenerima TukarJadwal[] @relation("JadwalTukarPenerima")

  @@map("jadwal")
}

model TukarJadwal {
  id String @id @default(cuid())

  pengajuId  String
  penerimaId String

  jadwalPengajuId  String
  jadwalPenerimaId String

  tanggalJadwalPengaju  DateTime
  tanggalJadwalPenerima DateTime

  status StatusTukarJadwal @default(MENUNGGU)

  ditanggapiAt DateTime?
  dibatalkanAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pengaju  User @relation("UserTukarPengaju", fields: [pengajuId], references: [id])
  penerima User @relation("UserTukarPenerima", fields: [penerimaId], references: [id])

  jadwalPengaju  Jadwal @relation("JadwalTukarPengaju", fields: [jadwalPengajuId], references: [id])
  jadwalPenerima Jadwal @relation("JadwalTukarPenerima", fields: [jadwalPenerimaId], references: [id])

  @@index([pengajuId, status])
  @@index([penerimaId, status])
  @@index([jadwalPengajuId, tanggalJadwalPengaju])
  @@index([jadwalPenerimaId, tanggalJadwalPenerima])
  @@index([status, tanggalJadwalPengaju])
  @@index([status, tanggalJadwalPenerima])
  @@map("tukar_jadwal")
}

model Absensi {
  id            String  @id @default(cuid())
  userId        String
  ruanganId     String?
  jadwalId      String?
  dicatatOlehId String?
  izinId        String?

  tipe   TipeAbsensi
  status StatusAbsensi
  sumber SumberAbsensi @default(QR)

  waktuScan DateTime @default(now())
  tanggal   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jadwal  Jadwal?  @relation(fields: [jadwalId], references: [id])
  ruangan Ruangan? @relation(fields: [ruanganId], references: [id])
  izin    Izin?    @relation(fields: [izinId], references: [id], onDelete: SetNull)

  user        User  @relation("AbsensiPegawai", fields: [userId], references: [id], onDelete: Cascade)
  dicatatOleh User? @relation("AbsensiDicatatOleh", fields: [dicatatOlehId], references: [id], onDelete: SetNull)

  @@index([userId, tanggal, tipe])
  @@index([jadwalId, tanggal])
  @@index([dicatatOlehId, tanggal])
  @@index([izinId])
  @@map("absensi")
}

model Pengaturan {
  id                       String   @id @default(cuid())
  toleransiMengajarMenit   Int      @default(30) @map("toleransiMenit")
  jamBerangkatMulai        String   @default("07:00")
  jamBerangkatSelesai      String   @default("12:00")
  jamPulangMulai           String   @default("13:00")
  jamPulangSelesai         String   @default("16:00")
  templatePesanWa          String   @default("Yth. Bpk/Ibu {nama},\nAnda terjadwal mengajar {mapel} kelas {kelas} pada jam {jam} hari ini.\nMohon konfirmasi kehadiran Anda.\nTerima kasih.")
  updatedAt                DateTime @updatedAt
  jamBerangkatHadirSelesai String   @default("10:00")

  @@map("pengaturan")
}

model KegiatanStaff {
  id         String   @id @default(cuid())
  userId     String
  tanggal    DateTime
  catatan    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  jamMulai   String
  jamSelesai String?
  user       User     @relation(fields: [userId], references: [id])

  @@map("kegiatan_staff")
}

model Pengumuman {
  id        String   @id @default(cuid())
  judul     String
  isi       String
  tanggal   DateTime @default(now())
  aktif     Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pembuat   User     @relation(fields: [createdBy], references: [id])

  @@map("pengumuman")
}

model Siswa {
  id               String                 @id @default(cuid())
  nama             String
  nis              String                 @unique
  kelasId          String
  kodeQr           String                 @unique
  aktif            Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  jenisKelamin     String
  absensiKegiatan  AbsensiKegiatanSiswa[]
  absensi          AbsensiSiswa[]
  rekapPelanggaran RekapPelanggaran[]
  kelas            Kelas                  @relation(fields: [kelasId], references: [id])
  ortu             UserOrtu?

  @@map("siswa")
}

model AbsensiSiswa {
  id        String        @id @default(cuid())
  siswaId   String
  kelasId   String
  tanggal   DateTime
  waktuScan DateTime      @default(now())
  status    StatusAbsensi
  createdAt DateTime      @default(now())
  kelas     Kelas         @relation(fields: [kelasId], references: [id])
  siswa     Siswa         @relation(fields: [siswaId], references: [id])

  @@unique([siswaId, tanggal])
  @@map("absensi_siswa")
}

model KegiatanSiswa {
  id        String                 @id @default(cuid())
  nama      String
  tanggal   DateTime
  aktif     Boolean                @default(true)
  createdAt DateTime               @default(now())
  absensi   AbsensiKegiatanSiswa[]
}

model AbsensiKegiatanSiswa {
  id         String        @id @default(cuid())
  siswaId    String
  kegiatanId String
  waktuScan  DateTime      @default(now())
  status     StatusAbsensi
  kegiatan   KegiatanSiswa @relation(fields: [kegiatanId], references: [id])
  siswa      Siswa         @relation(fields: [siswaId], references: [id])

  @@unique([siswaId, kegiatanId])
}

model CatatanHarian {
  id        String   @id @default(cuid())
  userId    String
  tanggal   DateTime
  kegiatan  String
  hasil     String
  kendala   String?
  foto      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tanggal])
  @@map("catatan_harian")
}

model RekapPelanggaran {
  id               String   @id @default(cuid())
  siswaId          String
  mingguKe         Int
  tahunAjaran      String
  semester         String
  tanggalMulai     DateTime
  tanggalAkhir     DateTime
  subuhS           Int      @default(0)
  subuhI           Int      @default(0)
  subuhA           Int      @default(0)
  dzuhurS          Int      @default(0)
  dzuhurI          Int      @default(0)
  dzuhurA          Int      @default(0)
  asarS            Int      @default(0)
  asarI            Int      @default(0)
  asarA            Int      @default(0)
  magribS          Int      @default(0)
  magribI          Int      @default(0)
  magribA          Int      @default(0)
  isyaS            Int      @default(0)
  isyaI            Int      @default(0)
  isyaA            Int      @default(0)
  btaS             Int      @default(0)
  btaI             Int      @default(0)
  btaA             Int      @default(0)
  ekskulS          Int      @default(0)
  ekskulI          Int      @default(0)
  ekskulA          Int      @default(0)
  vokasionalS      Int      @default(0)
  vokasionalI      Int      @default(0)
  vokasionalA      Int      @default(0)
  piketS           Int      @default(0)
  piketI           Int      @default(0)
  piketA           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  apnMingguIni     Int      @default(0)
  apnTotal         Int      @default(0)
  appMingguIni     Int      @default(0)
  appTotal         Int      @default(0)
  kbmA             Int      @default(0)
  kbmI             Int      @default(0)
  kbmS             Int      @default(0)
  keterangan       String?
  lain             Int      @default(0)
  noUrut           Int?
  pembimbingan     String?
  sisaApMingguIni  Int      @default(0)
  sisaApMingguLalu Int      @default(0)
  sisaApTotal      Int      @default(0)
  siswa            Siswa    @relation(fields: [siswaId], references: [id])

  @@unique([siswaId, mingguKe, tahunAjaran, semester])
  @@map("rekap_pelanggaran")
}

model Izin {
  id           String     @id @default(cuid())
  userId       String
  jenisIzin    JenisIzin
  jenisCustom  String?
  tanggalMulai DateTime
  tanggalAkhir DateTime
  keterangan   String
  suratUrl     String?
  status       StatusIzin @default(APPROVED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  absensi Absensi[]

  @@map("izin")
}

model KalenderAkademik {
  id             String       @id @default(cuid())
  judul          String
  deskripsi      String?
  tipe           TipeKalender
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum Role {
  ADMIN
  PIMPINAN
  GURU
  STAFF
  ORTU
  PIKET
}

enum StatusAbsensi {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPHA
}

enum TipeAbsensi {
  BERANGKAT
  JAM_MENGAJAR
  PULANG
}

enum SumberAbsensi {
  QR
  MANUAL
  PERIZINAN
}

enum HariMinggu {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

enum TipeKalender {
  LIBUR_NASIONAL
  LIBUR_SEKOLAH
  UJIAN
  KEGIATAN
  SEMESTER
}

enum SemesterAkademik {
  GANJIL
  GENAP
}

enum StatusIzin {
  APPROVED
  DITOLAK
  DIBATALKAN
}

enum JenisIzin {
  SAKIT
  IZIN
  DINAS_LUAR
  CUTI
  LAINNYA
}

enum StatusTukarJadwal {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN
}
